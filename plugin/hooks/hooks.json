{
  "description": "Optional plan review in Margin. Does nothing unless IMARK_PLAN_REVIEW is set.",
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/margin.mjs\" plan-hook",
            "timeout": 345600
          }
        ]
      }
    ]
  }
}
